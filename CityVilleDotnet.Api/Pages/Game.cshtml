@page
@using System.Globalization
@using CityVilleDotnet.Common.Utils
@inject Microsoft.Extensions.Localization.IStringLocalizer<CityVilleDotnet.Api.Resources.SharedResource> Localizer
@{
	Layout = "Shared/_GameLayout";
	var useSwf2es = Request.Query["player"] == "swf2es";
}

@model CityVilleDotnet.Api.Pages.GameModel

@section Header {
	<script type="text/javascript" src="/ag/intro.js?v=3"></script>
	<script>addEventListener("DOMContentLoaded",function(){var n=document.querySelector(".cv-navbar");function f(){if(n)document.documentElement.style.setProperty("--ag-nav-h",n.offsetHeight+"px")}f();addEventListener("resize",f)});</script>
	<script>window.AG_PLAYER = { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UserName)), uid: "@Model.Uid", level: @Model.Level, locale: "@Model.GameLocale", daily: @Html.Raw(Model.DailyBonusJson) };</script>
	<script type="text/javascript" src="/ag/daily.js?v=3"></script>
	<script type="text/javascript" src="/ag/franchise.js?v=2"></script>
	<script type="text/javascript" src="/ag/challenges.js?v=3"></script>
	<script type="text/javascript" src="/ag/nostalgia.js?v=4"></script>
	<script type="text/javascript" src="/ag/loader.js?v=3"></script>
	<script type="text/javascript" src="jquery.min.js"></script>
	<script type="text/javascript" src="flash_integration.min.js"></script>
	<script type="text/javascript" src="swfobject.min.js"></script>
	
	<script>
		document.cookie = "nativeFlash=" + (navigator.plugins && navigator.plugins["Shockwave Flash"] ? "1" : "0") + "; path=/; max-age=31536000; SameSite=Lax";
	</script>
	
	<script>
		const cvTouch = matchMedia("(pointer: coarse)").matches;
		const cvIos = /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
		
		if (cvTouch) {
			Object.defineProperty(window, "devicePixelRatio", { get: () => 1 });
		}
	</script>
	
	@if (useSwf2es)
	{
		<script type="module">
			import { configure, replaceFlash } from "https://unpkg.com/swf2es@0.1";
			configure({ cache: true });
			replaceFlash();
		</script>
	}
	else
	{
		<script type="text/javascript" src="@(Model.Request.Query["rf"] == "2" ? "ruffle2/ruffle.js?v=1" : "ruffle/ruffle.js?v=3")"></script>
	}

	<style>
		#cvGame { width: 960px; height: 756px; }
		/* Allow Games: juego a pantalla completa en PC (el juego se adapta al tamaño) */
		@@media (pointer: fine) {
			body:has(#cvGame) { background: transparent !important; }
			#cvGame { width: 100%; height: calc(100dvh - var(--ag-nav-h, 72px)); min-height: 560px; background: #000; }
			#flashOuterContainer, #flashContent, #cvGame object, #cvGame ruffle-object, #cvGame ruffle-embed { width: 100% !important; height: 100% !important; display: block; }
			body:has(#cvGame) .container.py-4 { max-width: none !important; padding: 0 !important; }
			html:has(#cvGame), body:has(#cvGame) { overflow: hidden !important; height: 100%; }
			body:has(#cvGame) footer, body:has(#cvGame) #agInvite, body:has(#cvGame) #agBanner { display: none !important; }
			#cvGame { background: #12384f; }
			/* Allow Games: en pantallas muy anchas el juego no se estira de lado a lado (se descuadraban los botones);
			   queda centrado con una proporcion como la original y fondo a los lados */
			#cvGame { width: min(100%, calc((100dvh - var(--ag-nav-h, 72px)) * 1.6), 1760px); margin: 0 auto; box-shadow: 0 0 0 1px rgba(255,255,255,.06), 0 0 40px rgba(0,0,0,.45); }
			body:has(#cvGame) { background: transparent !important; }
		}
		#cvRotate, .cv-overlay-btn { display: none; }

		@@media (pointer: coarse) {
			html, body { overflow: hidden; }
			.cv-overlay-btn { display: block; position: fixed; left: 4px; z-index: 1046; width: 36px; height: 36px; padding: 0; border: 0; border-radius: 8px; background: rgba(0, 0, 0, .5); color: #fff; font-size: 1.25rem; }
			#cvMenuToggle { top: 4px; }
			#cvCheatToggle { bottom: 4px; }
			#cheatCard { display: none; }
			body.cv-cheat-open #cheatCard { display: flex; position: fixed; left: 4px; bottom: 44px; z-index: 1045; width: min(420px, calc(100vw - 8px)); max-height: calc(100dvh - 52px); overflow-y: auto; margin: 0 !important; }
			body.cv-cheat-open #cheatCard .card-header { display: none !important; }
			body.cv-cheat-open #cheatPanel { display: block; }
			#cheatCard input { font-size: 16px; }
			.cv-navbar { display: none; }
			body.cv-menu-open .cv-navbar { display: flex; position: fixed; top: 0; left: 0; right: 0; z-index: 1045; padding: 0 8px 0 48px; }
			.cv-navbar .container { padding: 0; }
			.cv-navbar .container > a { display: none !important; }
			#cvGame { position: fixed; inset: 0; width: 100vw; height: 100dvh; z-index: 1040; background: #000; touch-action: none; }
			#flashOuterContainer { transform-origin: 0 0; }
			#flashContent, #cvGame object, #cvGame ruffle-object, #cvGame ruffle-embed, #cvGame swf2es-player { width: 100% !important; height: 100% !important; }
		}

		@@media (pointer: coarse) and (orientation: portrait) {
			#cvRotate { display: flex; position: fixed; inset: 0; z-index: 1050; background: #000; color: #fff; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
		}
	</style>
}

<button id="cvMenuToggle" class="cv-overlay-btn" type="button" aria-label="@Localizer["ToggleMenu"]"
        onclick="document.body.classList.toggle('cv-menu-open'); this.firstElementChild.classList.toggle('bi-x-lg'); this.firstElementChild.classList.toggle('bi-list');">
	<i class="bi bi-list"></i>
</button>

<div id="cvRotate">
	<i class="bi bi-phone-landscape display-4 mb-3"></i>
	<p class="px-4">@Localizer["RotateDevice"]</p>
</div>

<div id="cvGame" class="mx-auto">
	<div id="flashOuterContainer">
		<div id="flashContent">
			<object id="flashapp" name="flashapp" width="960" height="756" type="application/x-shockwave-flash"
			        data="Preloader.swf">
				<param name="allowFullScreen" value="true"/>
				<param name="flashvars" value="@Model.BuildFlashVars()"/>
			</object>
		</div>
	</div>
</div>

@section Navbar {
	@{
		var agL = Model.GameLocale.Length >= 2 ? Model.GameLocale[..2] : "es";
		var agCh = agL switch { "en" => "Challenges", "pt" => "Desafios", "fr" => "Défis", "it" => "Sfide", "de" => "Aufgaben", _ => "Desafíos" };
		var agDy = agL switch { "en" => "Daily reward", "pt" => "Prêmio diário", "fr" => "Récompense", "it" => "Premio", "de" => "Belohnung", _ => "Premio diario" };
		var agInv = agL switch { "en" => "Invite friends", "pt" => "Convidar amigos", "fr" => "Inviter des amis", "it" => "Invita amici", "de" => "Freunde einladen", _ => "Invitar amigos" };
	}
	<button type="button" class="btn btn-sm btn-info font-weight-bold mr-2 my-2" style="border-radius:999px;white-space:nowrap" onclick="window.agOpenDaily&&window.agOpenDaily()"><img class="agi" src="/ag/ic/gift.png" alt="" draggable="false"/>@agDy</button>
	<button type="button" class="btn btn-sm btn-warning font-weight-bold mr-2 my-2" style="border-radius:999px;white-space:nowrap" onclick="window.agOpenChallenges&&window.agOpenChallenges()"><img class="agi" src="/ag/ic/trophy.png" alt="" draggable="false"/>@agCh</button>
	<button type="button" id="agInvBtn" class="btn btn-sm btn-success font-weight-bold mr-lg-3 my-2" style="border-radius:999px;white-space:nowrap"
	        onclick="(function(b){var u=location.origin+'/invitar/'+encodeURIComponent(window.AG_PLAYER.name);try{navigator.clipboard.writeText(u)}catch(e){}var t=b.innerHTML;b.innerHTML='<img class=&quot;agi&quot; src=&quot;/ag/ic/check.png&quot; alt=&quot;&quot; draggable=&quot;false&quot;/>'+((window.AG_PLAYER.locale||'es').indexOf('es')===0?'¡Enlace copiado!':'Link copied!');setTimeout(function(){b.innerHTML=t},2500)})(this)"><img class="agi" src="/ag/ic/mail.png" alt="" draggable="false"/>@agInv</button>
	<div class="d-flex align-items-center mr-lg-3 my-2" title="@Localizer["GameLanguage"]">
		<label class="mb-0 mr-2 text-secondary" for="gameLocale"><i class="bi bi-globe2"></i></label>
		<select id="gameLocale" class="custom-select custom-select-sm w-auto" aria-label="@Localizer["GameLanguage"]"
		        onchange="document.cookie = 'gameLocale=' + this.value + '; path=/; max-age=31536000; SameSite=Lax'; window.location.reload();">
			@foreach (var gameLocale in LocaleUtils.GameLocales)
			{
				var culture = CultureInfo.GetCultureInfo(gameLocale.Replace('_', '-'));
				<option value="@gameLocale" selected="@(gameLocale == Model.GameLocale)">@culture.TextInfo.ToTitleCase(culture.NativeName)</option>
			}
		</select>
	</div>
}

@if (Model.EnableCheat)
{
	<button id="cvCheatToggle" class="cv-overlay-btn" type="button" aria-label="@Localizer["CheatMenu"]"
	        onclick="document.body.classList.toggle('cv-cheat-open'); this.firstElementChild.classList.toggle('bi-chevron-up'); this.firstElementChild.classList.toggle('bi-chevron-down');">
		<i class="bi bi-chevron-up"></i>
	</button>
	await Html.RenderPartialAsync("_CheatMenu");
}

<script>
	function getUserInfo() {
		console.log("getUserInfo called");

		return {
			"zid": @(Model.Uid),
			"uid": "@(Model.Uid)",
			"first_name": "@Model.UserName",
			"name": "@Model.UserName",
			"sex": "M",
			"pic_square": "@($"{Request.Scheme}://{Request.Host}{Request.PathBase}{Model.PictureUrl}")",
			"level": @(Model.Level)
		};
	}

	function getFriendData() {
		console.log("getFriendData called");

		return @Html.Raw(Model.FriendList);
	}

	function getAppFriendIds() {
		console.log("getAppFriendIds called");
		return [];
	}

	function onGameLoaded(seen, popp, canvas) {
		console.log("Game is loaded " + seen + ", " + popp + ", " + canvas);
		window.agLoaded = true; window.dispatchEvent(new Event("ag:loaded"));
	}

	function getAssetOverrides() {
		console.log("getAssetOverrides called");
		return {};
	}

	function getRuntimeVars() {
		return @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RuntimeVars));
	}

	function getExperiments() {
		return @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Experiments));
	}

	// Allow Games: textos que faltaban en los archivos de idioma del juego (nombres de objetos, expansiones, promos...).
	// Salen de la lista de textos mas nueva del juego; si un idioma no tiene la traduccion, va en ingles en vez del codigo.
	function getLocaleOverrides() {
		if (/[?&]loc=0/.test(location.search)) return null;
		try {
			var x = new XMLHttpRequest();
			x.open("GET", "/ag/loc/@(Model.GameLocale).json?v=3", false);
			x.send();
			if (x.status === 200) return JSON.parse(x.responseText);
		} catch (e) { console.warn("[AG] locale overrides", e); }
		return null;
	}

	function getFlashApp() {
		return document.getElementById('flashapp');
	}

	function sendRequest(a, b, c, d) {
		console.log("sendRequest called: ", a, b, c, d);
	}

	function completeSendRequest(b) {
		console.log("completeSendRequest called:", b)
	}

	// Allow Games: los botones del juego que antes abrian paginas de Facebook (agregar vecinos, invitar)
	function agRoute() {
		var raw = [].slice.call(arguments).join(" "), u = raw.toLowerCase();
		var crew = u.match(/crew\.php\?[^ ]*mid=(\d+)/);
		if (crew && window.agOpenCrew) { window.agOpenCrew(crew[1]); return true; }
		if (/gift/.test(u) && window.agOpenGifts) { var g = raw.match(/[?&]gift=([^& ]+)/i); window.agOpenGifts(g ? decodeURIComponent(g[1]) : null); return true; }
		if (/invite|neighbor|friend|vecin/.test(u) && window.agOpenFriends) { window.agOpenFriends(); return true; }
		if (/money\.php|payment|getcash|buy_?cash/.test(u) && window.agOpenChallenges) { window.agOpenChallenges(); return true; }
		return false;
	}

	// Allow Games: comprar City Cash con dinero real no existe aqui; esos botones abren los Desafios
	window.fbc_popup_open = window.fbc_popup_open_no_reload = window.openPaymentsFrame_overlayManager = window.buy_inapp = function () {
		console.log("[AG] compra -> desafios", [].slice.call(arguments));
		if (window.agOpenChallenges) window.agOpenChallenges();
		var f = getFlashApp();
		try { if (f && f.thawGame) f.thawGame(); } catch (e) { }
		try { if (f && f.enableAllInput) f.enableAllInput(); } catch (e) { }
		return true;
	};

	ZYFrameManager = {
		"reloadApp": function () {
			console.log("Reload App");
			window.location.reload();
		},
		"navigateTo": function (a, b, c) {
			console.log("Navigate To" + a + " - " + b + " - " + c);
			agRoute(a, b, c);
		},
		"openTab": function (a, b, c) {
			console.log("Open Tab" + a + " - " + b + " - " + c);
			agRoute(a, b, c);
		},
		"switchToTab": function (a) {
			console.log("Switch To Tab" + a);
			agRoute(a);
		},
		// anuncios de "ver para ganar": aqui no hay anuncios
		"showScreenshot": function () { },
		"hideScreenshot": function () { },
		"setIsShowingAds": function () { },
		"unsetIsShowingAds": function () { }
	};

	// Allow Games: funciones que el juego le pedia a Facebook o a Zynga. Aqui no hay Facebook, ni anuncios,
	// ni compras con dinero real: se responden sin hacer nada o se mandan a nuestro sistema.
	;(function () {
		function f() { var a = getFlashApp(); try { if (a && a.thawGame) a.thawGame(); } catch (e) { } try { if (a && a.enableAllInput) a.enableAllInput(); } catch (e) { } }
		function nada() { return false; }
		// suscripciones y compras -> desafios
		window.openSubscriptionFBPop = function () { if (window.agOpenChallenges) window.agOpenChallenges(); f(); return true; };
		window.refresh_app_on_purchase = nada;
		// anuncios, encuestas y "me gusta" de Facebook
		window.showInterstitialAd = nada;
		window.theFarmOverlay = { showFBLikeOverlay: function () { f(); }, showSurveyOverlay: function () { f(); } };
		window.renderFlashUpgradeExperience = nada;
		// actividades de Facebook / estadisticas de Zynga
		window.startActivity = nada; window.hasActivities = nada; window.getProviderId = function () { return "allowgames"; };
		window.snapiAwardXp = nada; window.recordLoadStats = nada; window.broadcastHeartbeat = nada;
		window.getCiproConfig = function () { return null; }; window.getCiproSessionId = function () { return ""; };
		window.getWatchedCounters = function () { return {}; }; window.notifyJSClientIsReady = nada;
		window.getPreviousGPUResults = function () { return null; }; window.getGPUResults = function () { return null; }; window.setGPUResults = nada;
		window.Javascript = { execute: nada };
		window.bridgeFacebookReply = nada;
		window.SNAPI = window.SNAPI || {};
		window.SNAPI.getAllConnections = window.SNAPI.getAllConnections || function () { return { session: { access_token: "allowgames" } }; };
		// amigos conectados: los de la barra que tengan el juego abierto
		window.getOnlineFriends = function () { return window.agOnlineFriends || []; };
		window.getSupportedLanguages = function () { return ["en_US", "es_ES", "fr_FR", "it_IT"]; };
		// el juego perdio la conexion con el servidor: recargar una sola vez, sin bucles
		window.showStaleAuthError = function () {
			var n = 0; try { n = +sessionStorage.getItem("agStale") || 0; sessionStorage.setItem("agStale", n + 1); } catch (e) { }
			if (n < 1) setTimeout(function () { location.reload(); }, 1500);
		};
		window.addEventListener("ag:loaded", function () { try { sessionStorage.removeItem("agStale"); } catch (e) { } });
	})();

	// Resize the game for mobile clients
	if (cvTouch) {
		const fitGame = () => {
			const scale = Math.min(1, innerWidth / 960, innerHeight / 756);
			const container = document.getElementById("flashOuterContainer");
			container.style.width = (innerWidth / scale) + "px";
			container.style.height = (innerHeight / scale) + "px";
			container.style.transform = "scale(" + scale + ")";
		};
		addEventListener("resize", fitGame);
		fitGame();
	}

	window.RufflePlayer = window.RufflePlayer || {};
	window.RufflePlayer.config = {
		allowScriptAccess: true,
		autoplay: "on",
		unmuteOverlay: "hidden",
		logLevel: "warn",
		polyfills: true,
		allowFullscreen: true,
		wmode: "window",
		deviceFontRenderer: "canvas",
		maxExecutionDuration: 360,
		quality: cvTouch ? "low" : "high",
		preferredRenderer: cvIos ? "wgpu-webgl" : null
	};
	// Allow Games: pruebas de calidad por URL (?q=best&dfr=embedded&r=webgl)
	(function () {
		var u = new URLSearchParams(location.search), c = window.RufflePlayer.config;
		// ajuste del jugador: calidad del juego (Ajustes > Calidad)
		var mq = document.cookie.match(/(?:^|; )agQuality=(low|medium|high)/);
		if (mq) c.quality = mq[1];
		if (u.get("q")) c.quality = u.get("q");
		if (u.get("dfr")) c.deviceFontRenderer = u.get("dfr");
		if (u.get("r")) c.preferredRenderer = u.get("r");
		if (u.get("scale")) { c.scale = u.get("scale"); c.forceScale = u.get("scale") !== "noScale"; }
	})();
</script>
