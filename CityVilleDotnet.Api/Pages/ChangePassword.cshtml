@page
@model CityVilleDotnet.Api.Pages.ChangePasswordModel
@using CityVilleDotnet.Api.Pages.Account
@{
	Layout = "Shared/_GameLayout";
}

<div class="card border-0 shadow-sm mb-4 mx-auto" style="max-width:420px">
	<div class="card-body">
		<h4 class="font-weight-bold mb-3"><i class="bi bi-key mr-2"></i>@AgText.Get("ChangeTitle")</h4>
		@if (Model.Done) { <div class="alert alert-success">@AgText.Get("Changed")</div> <a href="/Game" class="btn btn-primary btn-block">@AgText.Get("Back")</a> }
		else
		{
			@if (Model.Error != null) { <div class="alert alert-danger py-2">@Model.Error</div> }
			<form method="post">
				<div class="form-group"><label>@AgText.Get("Current")</label><input name="Current" type="password" class="form-control" autocomplete="current-password"/></div>
				<div class="form-group"><label>@AgText.Get("NewPass")</label><input name="Password" type="password" class="form-control" autocomplete="new-password"/></div>
				<div class="form-group"><label>@AgText.Get("Confirm")</label><input name="Confirm" type="password" class="form-control" autocomplete="new-password"/></div>
				<button type="submit" class="btn btn-primary btn-block font-weight-bold">@AgText.Get("Save")</button>
			</form>
		}
	</div>
</div>
