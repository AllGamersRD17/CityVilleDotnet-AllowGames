@using System.Reflection
@using CityVilleDotnet.Api.Common.Identity
@using Microsoft.AspNetCore.Authorization
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resources.SharedResource> Localizer
@inject IAuthorizationService AuthorizationService

@{
    var isAdmin = (await AuthorizationService.AuthorizeAsync(User, AdminPolicy.Name)).Succeeded;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
    <title>CityVille Revived · Allow Games</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <link type="text/css" rel="stylesheet" href="~/css/site.css"/>
    <link rel="icon" href="/ag/favicon.ico"/>
    <link type="text/css" rel="stylesheet" href="/ag/allowgames.css?v=11"/>
    <link rel="manifest" href="/manifest.webmanifest"/>
    <meta name="theme-color" content="#2f8fc4"/>
    <meta name="mobile-web-app-capable" content="yes"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
    <meta name="apple-mobile-web-app-title" content="CityVille"/>
    <link rel="apple-touch-icon" href="/ag/icon_192.png"/>

    @await RenderSectionAsync("Header", required: false)
</head>
<body class="bg-light d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-xl cv-navbar sticky-top border-bottom bg-white">
    <div class="container">
        <a class="ag-brand py-1" href="/Game" title="CityVille Revived · Allow Games">
            <img class="ag-ag" src="/ag/allowgames_nav.png" alt="Allow Games" draggable="false"/>
            <img class="ag-cv" src="/ag/logo_revived.png" alt="CityVille Revived" draggable="false"/>
            <span class="ag-beta">BETA v0.22</span>
        </a>

        <button class="navbar-toggler border-secondary rounded" type="button" data-toggle="collapse"
                data-target="#cvNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="cvNavbar">
            <ul class="navbar-nav mr-auto ml-xl-3">
@if (!string.Equals(Context.Request.Path.Value?.TrimEnd('/'), "/Game", StringComparison.OrdinalIgnoreCase))
                {
                <li class="nav-item">
                    <a class="nav-link text-secondary font-weight-bold d-flex align-items-center rounded px-3 py-2 my-2 mx-1 cv-hover"
                       asp-page="/Game" title="Game">
                        <img class="agi" src="/ag/ic/city.png" alt="" draggable="false"/>
                        @Localizer["Play"]
                    </a>
                </li>
                }
                <li class="nav-item">
                    <a class="nav-link text-secondary font-weight-bold d-flex align-items-center rounded px-3 py-2 my-2 mx-1 cv-hover"
                       asp-page="/Friends/List" title="Friends">
                        <img class="agi" src="/ag/ic/friends.png" alt="" draggable="false"/>
                        @Localizer["Friends"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary font-weight-bold d-flex align-items-center rounded px-3 py-2 my-2 mx-1 cv-hover position-relative"
                       href="/novedades.html" title="Novedades">
                        <img class="agi" src="/ag/ic/news.png" alt="" draggable="false"/><span id="agNewsTxt">Novedades</span>
                        <span id="agNewsDot" style="display:none;position:absolute;top:8px;right:6px;width:10px;height:10px;border-radius:50%;background:#e8572a;box-shadow:0 0 0 2px #fff"></span>
                    </a>
                    <script>(function(){var V="0.22",l="es";try{l=(localStorage.getItem("lang")||navigator.language||"es").slice(0,2);if(localStorage.getItem("agNewsSeen")!==V)document.getElementById("agNewsDot").style.display="block"}catch(e){}
                    var t={es:"Novedades",en:"News",pt:"Novidades",fr:"Nouveautés",it:"Novità",de:"Neuigkeiten"};document.getElementById("agNewsTxt").textContent=t[l]||t.en})();</script>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary font-weight-bold d-flex align-items-center rounded px-3 py-2 my-2 mx-1 cv-hover"
                       href="/ranking.html" title="Ranking">
                        <img class="agi" src="/ag/ic/trophy.png" alt="" draggable="false"/>Ranking
                    </a>
                </li>
                <li class="nav-item d-flex align-items-center px-3 py-2 my-2 mx-1 small font-weight-bold text-success ag-online" title="En línea">
                    <span class="ag-dot"></span><span id="agOnline">…</span>
                </li>
                @if (isAdmin)
                {
                    <li class="nav-item">
                        <a class="nav-link text-danger font-weight-bold d-flex align-items-center rounded px-3 py-2 my-2 mx-1 cv-hover"
                           asp-page="/Admin/Index" title="Admin">
                            <img class="agi" src="/ag/ic/vip.png" alt="" draggable="false"/>
                            @Localizer["Admin"]
                        </a>
                    </li>
                }
            </ul>

            @await RenderSectionAsync("Navbar", required: false)

            <div class="dropdown">
                <div class="d-flex align-items-center p-2 rounded cv-hover" role="button"
                     data-toggle="dropdown" aria-expanded="false">
                    <img class="rounded mr-2" src="@(ViewData["ProfilePictureUrl"] ?? "/blank.png")" style="width: 50px; height: 50px" alt="Profile" />
                    <div class="d-none d-xl-block">
                        <div class="font-weight-bold text-dark small">@ViewData["PlayerName"]</div>
                        <div class="text-info small"><img class="agi" src="/ag/ic/xp.png" alt="" draggable="false"/>@Localizer["Level"] @ViewData["PlayerLevel"]
                        </div>
                    </div>
                    <svg class="cv-chevron d-none d-xl-block text-secondary ml-2" xmlns="http://www.w3.org/2000/svg"
                         width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path
                            d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                    </svg>
                </div>
                <ul class="dropdown-menu dropdown-menu-right shadow-lg border rounded p-2 mt-2">
                    <li>
                        <a class="dropdown-item d-flex align-items-center rounded py-2 px-3 text-secondary"
                           asp-page="/Profile" title="Profile">
                            <svg class="mr-2" width="15" height="15" viewBox="0 0 16 16" fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.4" stroke-linecap="round">
                                <circle cx="8" cy="5" r="3"/>
                                <path d="M2 15c0-3 2.5-5 6-5s6 2 6 5"/>
                            </svg>
                            @Localizer["Profile"]
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center rounded py-2 px-3 text-secondary" href="/ChangePassword">
                            <i class="bi bi-key mr-2"></i>@CityVilleDotnet.Api.Pages.Account.AgText.Get("ChangeTitle")
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center rounded py-2 px-3 text-secondary"
                           href="/Settings">
                            <svg class="mr-2" width="15" height="15" viewBox="0 0 16 16" fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.4" stroke-linecap="round">
                                <circle cx="8" cy="8" r="2.5"/>
                                <path
                                    d="M8 1v2M8 13v2M1 8h2M13 8h2M2.9 2.9l1.4 1.4M11.7 11.7l1.4 1.4M13.1 2.9l-1.4 1.4M4.3 11.7l-1.4 1.4"/>
                            </svg>
                            @Localizer["Settings"]
                        </a>
                    </li>
                    <li>
                        <hr class="dropdown-divider my-1 mx-3">
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center rounded py-2 px-3 text-danger"
                           asp-page="/Account/Logout" title="Logout">
                            <svg class="mr-2" width="15" height="15" viewBox="0 0 16 16" fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.4" stroke-linecap="round">
                                <path d="M6 2H3a1 1 0 00-1 1v10a1 1 0 001 1h3M11 11l3-3-3-3M6 8h8"/>
                            </svg>
                            @Localizer["Logout"]
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<div class="container py-4 flex-grow-1">
    <div class="d-flex justify-content-center">
        <div class="w-100">
            @RenderBody()
        </div>
    </div>
</div>

@if (ViewData["PlayerName"] is string agName && !string.IsNullOrEmpty(agName))
{
    <div class="ag-invite" id="agInvite">
        <span class="ag-invite-t" data-i="inv"></span>
        <input id="agInviteUrl" readonly value="" aria-label="link">
        <button type="button" id="agInviteBtn" class="btn btn-primary btn-sm" data-i="copy"></button>
    </div>
    <script>
        (function () {
            var u = location.origin + '/invitar/' + encodeURIComponent(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(agName)));
            var i = document.getElementById('agInviteUrl'); i.value = u;
            document.getElementById('agInviteBtn').onclick = function () {
                i.select(); try { navigator.clipboard.writeText(u); } catch (e) { document.execCommand('copy'); }
                this.innerHTML = '<img class="agi" src="/ag/ic/check.png" alt="" draggable="false"/>';
            };
        })();
    </script>
}
<div class="ag-banner" id="agBanner" hidden></div>
<footer class="mt-auto">
    <div style="max-width:760px; margin: 0 auto;">
        <hr class="my-2">
        <p class="text-center text-muted small mb-3">
            CityVille Revived BETA v0.22 · <b>Allow Games</b> (AllGamersRD) ·
            servidor basado en <a class="text-white" href="https://github.com/besuper/CityVilleDotnet" target="_blank" rel="noopener">CityVilleDotnet</a> ·
            proyecto de fans sin fines de lucro, no afiliado a Zynga · <a href="/creditos.html" style="color:inherit;font-weight:700">Créditos</a>
        </p>
    </div>
</footer>
<script src="/ag/scene.js?v=2"></script>
<script>(function(){var p=location.pathname.toLowerCase().replace(/\/$/,"");document.querySelectorAll(".cv-navbar .nav-link").forEach(function(l){var h=(l.getAttribute("href")||"").toLowerCase().replace(/\/$/,"");if(h&&h===p)l.classList.add("ag-on")})})();</script>
<script src="/ag/site.js?v=3"></script>
<script src="/ag/community.js?v=15"></script>
<script src="/ag/mobile.js?v=2"></script>
<style>@@media (min-width:1200px){.cv-navbar>.container{max-width:1720px}}</style>
<script>
// Allow Games: la barra de arriba nunca se corta. Si no cabe, se achica entera (igual que se ve en grande).
(function () {
    var n = document.querySelector('.cv-navbar>.container'), tg = document.querySelector('.cv-navbar .navbar-toggler');
    if (!n) return;
    var busy = false;
    function fit() {
        if (busy) return; busy = true;
        n.style.zoom = '';
        if (!tg || getComputedStyle(tg).display === 'none') {
            var cs = getComputedStyle(n), avail = n.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
            n.style.width = 'max-content'; n.style.maxWidth = 'none';
            var need = n.scrollWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
            n.style.width = ''; n.style.maxWidth = '';
            if (need > avail + 1) n.style.zoom = Math.max(0.6, (avail - 4) / need).toFixed(3);
        }
        var nav = document.querySelector('.cv-navbar');
        if (nav) document.documentElement.style.setProperty('--ag-nav-h', nav.offsetHeight + 'px');
        busy = false;
    }
    var t; function later() { clearTimeout(t); t = setTimeout(fit, 60); }
    addEventListener('resize', later); addEventListener('load', fit);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    [300, 1500, 4000].forEach(function (ms) { setTimeout(fit, ms); });
    fit();
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js"
        integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj"
        crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct"
        crossorigin="anonymous"></script>
</body>
</html>