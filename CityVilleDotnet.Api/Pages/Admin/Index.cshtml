@page
@model CityVilleDotnet.Api.Pages.Admin.IndexModel

@section Header {
	<meta http-equiv="refresh" content="30">
}

<h4 class="font-outfit font-weight-bold text-dark mb-4">
	<i class="bi bi-speedometer2 mr-2 text-primary"></i>@Localizer["Dashboard"]
</h4>

@{ ViewData["Title"] = "Inicio del panel"; }
<div class="ad-quick">
	<a href="/Admin/Players"><img src="/ag/ic/friends.png" alt="">Jugadores</a>
	<a href="/Admin/Temporadas"><img src="/ag/ic/tree.png" alt="">Temporadas</a>
	<a href="/Admin/Logs"><img src="/ag/ic/news.png" alt="">Registros</a>
	<a href="#faltan"><img src="/ag/ic/alert.png" alt="">Lo que falta</a>
	<a href="/Game"><img src="/ag/ic/city.png" alt="">Ir al juego</a>
</div>
<div class="row row-cols-2 row-cols-md-4 mb-4">
	<div class="col mb-3">
		<div class="card border-0 shadow-sm h-100 text-center p-3">
			<i class="bi bi-broadcast text-success h4 mb-2"></i>
			<div class="font-weight-bold text-dark h5 mb-0">@Model.OnlinePlayers.Count.ToString("N0")</div>
			<div class="text-muted small">@Localizer["OnlinePlayers"]</div>
		</div>
	</div>
	<div class="col mb-3">
		<div class="card border-0 shadow-sm h-100 text-center p-3">
			<i class="bi bi-people-fill text-primary h4 mb-2"></i>
			<div class="font-weight-bold text-dark h5 mb-0">@Model.PlayersCount.ToString("N0")</div>
			<div class="text-muted small">@Localizer["Players"]</div>
		</div>
	</div>
	<div class="col mb-3">
		<div class="card border-0 shadow-sm h-100 text-center p-3">
			<i class="bi bi-person-plus-fill text-info h4 mb-2"></i>
			<div class="font-weight-bold text-dark h5 mb-0">@Model.NewPlayersCount.ToString("N0")</div>
			<div class="text-muted small">@Localizer["NewPlayers24h"]</div>
		</div>
	</div>
	<div class="col mb-3">
		<div class="card border-0 shadow-sm h-100 text-center p-3">
			<i class="bi bi-shield-lock-fill text-danger h4 mb-2"></i>
			<div class="font-weight-bold text-dark h5 mb-0">@Model.AdminsCount.ToString("N0")</div>
			<div class="text-muted small">@Localizer["Admins"]</div>
		</div>
	</div>
</div>

<div class="card border-0 shadow-sm">
	<div class="card-body">
		<div class="d-flex align-items-center justify-content-between mb-3">
			<h6 class="font-weight-bold text-dark mb-0">
				<i class="bi bi-broadcast mr-2 text-success"></i>@Localizer["OnlinePlayers"]
				<span class="badge badge-success ml-1">@Model.OnlinePlayers.Count</span>
			</h6>
			<span class="text-muted small"><i class="bi bi-arrow-repeat mr-1"></i>@Localizer["AutoRefresh"]</span>
		</div>

		@if (Model.OnlinePlayers.Any())
		{
			<div class="table-responsive">
				<table class="table table-hover table-sm mb-0">
					<thead>
					<tr>
						<th>@Localizer["Username"]</th>
						<th>Snuid</th>
						<th>@Localizer["Level"]</th>
						<th>@Localizer["World"]</th>
						<th>@Localizer["LastActivity"]</th>
					</tr>
					</thead>
					<tbody>
					@foreach (var player in Model.OnlinePlayers)
					{
						<tr>
							<td>
								<a asp-page="/Admin/Players/Edit" asp-route-id="@player.Id" class="font-weight-bold">
									<img src="@(player.ProfilePictureUrl ?? "/blank.png")" alt="" class="rounded mr-2" style="width:24px;height:24px;"/>@player.Username
								</a>
							</td>
							<td>@player.Snuid</td>
							<td>@player.Level</td>
							<td>@player.World</td>
							<td>@((int)(DateTimeOffset.Now - player.LastTrackingTimestamp).TotalSeconds) s</td>
						</tr>
					}
					</tbody>
				</table>
			</div>
		}
		else
		{
			<p class="text-muted mb-0">@Localizer["NoOnlinePlayers"]</p>
		}
	</div>
</div>


<div class="card mt-4" id="faltan">
	<div class="card-body">
		<div class="d-flex align-items-center justify-content-between mb-2">
			<h6 class="font-weight-bold mb-0"><i class="bi bi-bug-fill mr-2 text-danger"></i>Funciones del juego que el servidor todavía no sabe hacer</h6>
			<button class="btn btn-sm btn-primary" type="button" onclick="adMissing()"><i class="bi bi-arrow-repeat mr-1"></i>Actualizar</button>
		</div>
		<p class="text-muted small mb-3">Cada vez que un jugador toca algo que el servidor no conoce, aparece aquí. Las de arriba son las que más se usan: esas son las que hay que programar primero.</p>
		<div class="table-responsive ad-miss">
			<table class="table table-sm"><thead><tr><th>Función</th><th>Veces</th><th>Última vez</th></tr></thead><tbody id="adMissRows"><tr><td colspan="3" class="text-muted">Cargando…</td></tr></tbody></table>
		</div>
	</div>
</div>
<script>
	function adMissing() {
		const tb = document.getElementById("adMissRows");
		fetch("/api/ag/admin/missing", { credentials: "same-origin" }).then(r => r.ok ? r.json() : []).then(list => {
			const esc = x => String(x).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
			tb.innerHTML = list.length ? list.slice(0, 50).map(m => "<tr><td>" + esc(m.handler) + "</td><td class=\"cnt\">" + m.count + "</td><td>" + new Date(m.last).toLocaleString() + "</td></tr>").join("")
				: "<tr><td colspan=\"3\" class=\"text-success\"><i class=\"bi bi-check-circle-fill mr-1\"></i>Nada pendiente desde que arrancó el servidor.</td></tr>";
		}).catch(() => { tb.innerHTML = "<tr><td colspan=\"3\" class=\"text-muted\">No se pudo cargar.</td></tr>"; });
	}
	adMissing();
</script>
